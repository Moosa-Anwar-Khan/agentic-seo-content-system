# Local-only combined MVP. Never commit a filled .env file.
DEMO_MODE=true
COMBINED_MODE=true
STORAGE_BACKEND=sqlite
DATA_DIR=var
OUTPUT_DIR=outputs
AUTH_ENCRYPTION_KEY=
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:3000
LLM_MODEL_PLANNING=openai/gpt-5.4-mini
LLM_MODEL_DRAFTING=openai/gpt-5.4-mini
# Optional higher-quality writer profile; dated pricing is bundled.
# Research/QA/social routes may be configured independently.
BRIEFING_PROVIDER=openai
BRIEFING_MODEL=gpt-6.1-sol
CONTENT_PROVIDER=openai
CONTENT_MODEL=gpt-6.1-sol
AI_TASK_OPTIONS='{"briefing":{"reasoning_effort":"low"},"content":{"reasoning_effort":"low"}}'
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
SEO_STRATEGY_PROVIDER=deepseek
SEO_STRATEGY_MODEL=deepseek-flash
TOPIC_MAP_PROVIDER=deepseek
TOPIC_MAP_MODEL=deepseek-flash
SEO_QA_PROVIDER=deepseek
SEO_QA_MODEL=deepseek-flash
SOCIAL_CONTENT_PROVIDER=deepseek
SOCIAL_CONTENT_MODEL=deepseek-flash
ANTHROPIC_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GSC_SITE_URL=https://steuerkanzlei.example/
GSC_ACCESS_TOKEN=
WORDPRESS_BASE_URL=https://steuerkanzlei.example
MAX_RUN_USD=5.0
MAX_MONTHLY_USD=20.0
# Verify these upper USD allowances against your provider contract before filling them.
# Blank allowances block live paid requests; they are not published provider prices.
OFFICIAL_DISCOVERY_ENABLED=true
TAVILY_API_KEY=
TAVILY_REQUEST_MAX_USD=
OFFICIAL_DISCOVERY_RESULTS=5
FIRECRAWL_ENABLED=true
FIRECRAWL_API_KEY=
FIRECRAWL_REQUEST_MAX_USD=
IMAGE_REQUEST_MAX_USD=
MAX_RUN_TOKENS=120000
MAX_OUTPUT_TOKENS=12000
MAX_AUTO_REVISIONS=2
COMPETITOR_PAGES=5
RESEARCH_CACHE_HOURS=24
TAX_YEAR=2026
IMAGE_GENERATION_ENABLED=false
# Optional dashboard image set: one 2K master, three local channel variants.
# Uses OPENAI_API_KEY; no request is made until the user clicks Generate.
IMAGE_GENERATION_PROVIDER=openai
IMAGE_GENERATION_MODEL=gpt-image-2.5-flare
# Blank preserves legacy quality (high for a 2K master, medium otherwise).
IMAGE_QUALITY=medium
# Set IMAGE_REQUEST_MAX_USD above to a checked allowance, e.g. 0.25 USD.
# This is a reservation, not an exact price or provider-side billing cap.
IMAGE_PROMPT_ENABLED=false

# Append each new kind of recorded failure to DRAFT_FAILURE_CHECKLIST.md. Off by default;
# it writes only public failure summaries, never provider data or draft text.
FAILURE_CHECKLIST_AUTO=false

# Explicit Gemini API baseline via DataForSEO; not consumer-app ranking.
AI_VISIBILITY_MODEL=gemini-2.5-flash
