    {
      "id": "L13",
      "name": "Einwände",
      "rule": "„Typische Bedenken“"
    },
    {
      "id": "L14",
      "name": "FAQ + Ratgeber-Links",
      "rule": "6-8 Fragen, Pflichtfragen Kosten, Vorbereitung, Fristen, Wechsel, unvollständige Unterlagen; 2-4 Ratgeber-Links darunter"
    },
    {
      "id": "L15",
      "name": "Abschluss-CTA",
